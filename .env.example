# 64 hexadecimal characters (`openssl rand -hex 32`). Use a new value per environment and rotate with SESSION_ENCRYPTION_KEYS.
SESSION_ENCRYPTION_KEY=
# Optional keyring for rotation: kid1:64hex,kid0:64hex. The first entry writes new cookies.
SESSION_ENCRYPTION_KEYS=
# Optional dedicated HMAC master for cacheScope; otherwise the active session master is derived.
SESSION_CACHE_SCOPE_KEY=
# Optional dedicated HMAC master for opaque auth rate-limit identifiers; otherwise the cache/session master is derived.
REQUEST_GUARD_KEY=
# Optional previous single key during a controlled rotation from SESSION_ENCRYPTION_KEY.
# Envelopes written by that legacy single-key mode used the id "primary".
SESSION_ENCRYPTION_PREVIOUS_KEY=
# Legacy session cookies are rejected unless a time-bounded migration is explicitly enabled.
# When used, this must be a 13-digit Unix epoch in milliseconds, at most 30 days in the future.
LEGACY_SESSION_COOKIE_ACCEPT_UNTIL=
# Local development only. Production always fails closed without a real key.
ALLOW_INSECURE_SESSION_KEY=false
SESSION_MIGRATION_MODE=strict
TOTVS_TIMEOUT_MS=12000
# Canonical production origin used to validate auth POST requests (for example https://sapoconnect.vercel.app).
APP_ORIGIN=
# First deploy: dual. After the 7-day rollback window: cookie-only.
NEXT_PUBLIC_RECONNECT_MIGRATION_MODE=dual

# Server-only token used to read aggregated Vercel Web Analytics data.
# Create a dedicated token scoped to the account/team. Never prefix it with NEXT_PUBLIC_.
VERCEL_ANALYTICS_TOKEN=
# Required for projects owned by a Vercel team.
VERCEL_ANALYTICS_TEAM_ID=
# Optional on Vercel, where VERCEL_PROJECT_ID is exposed automatically.
VERCEL_ANALYTICS_PROJECT_ID=

# Server-only comma-separated RAs that receive the recurring Lite upgrade notice.
# Configure this only in the deployment environment. Never prefix it with NEXT_PUBLIC_.
SAPOCONNECT_LITE_RAS=
